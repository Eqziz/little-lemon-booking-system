<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="header">
    <div class="container nav-container">
      <h1 class="logo">Web Technologies 2</h1>
      <nav class="nav">
        <a href="/" class="nav-link">Home</a>
        <a href="/users" class="nav-link">Users (MVC)</a>
        <a href="/users/new" class="nav-link btn-link">+ Add User</a>
        <a href="/api/users" target="_blank" class="nav-link api-link">JSON API</a>
      </nav>
    </div>
  </header>

  <main class="container main-content">
    <div class="hero">
      <h2><%= title %></h2>
      <p class="subtitle">Welcome to the first backend assignment: Introduction to Web Technologies & MVC Architecture.</p>
      
      <div class="card info-card">
        <h3>Assignment 1 Highlights</h3>
        <ul>
          <li><strong>Architecture:</strong> Model-View-Controller (MVC) Pattern</li>
          <li><strong>Technology Stack:</strong> Node.js, Express.js, EJS View Engine</li>
          <li><strong>Student:</strong> <%= author %></li>
          <li><strong>Course:</strong> <%= course %></li>
        </ul>
      </div>

      <div class="actions">
        <a href="/users" class="btn btn-primary">Browse Users Directory</a>
        <a href="/users/new" class="btn btn-secondary">Create New Record</a>
      </div>
    </div>
  </main>

  <footer class="footer">
    <div class="container">
      <p>&copy; 2026 Astana IT University - Web Technologies 2 (Back End)</p>
    </div>
  </footer>
</body>
</html>
