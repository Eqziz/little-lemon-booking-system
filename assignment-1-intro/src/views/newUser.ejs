<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="header">
    <div class="container nav-container">
      <h1 class="logo">Web Technologies 2</h1>
      <nav class="nav">
        <a href="/" class="nav-link">Home</a>
        <a href="/users" class="nav-link">Users (MVC)</a>
        <a href="/users/new" class="nav-link active btn-link">+ Add User</a>
        <a href="/api/users" target="_blank" class="nav-link api-link">JSON API</a>
      </nav>
    </div>
  </header>

  <main class="container main-content">
    <div class="form-card">
      <h2><%= title %></h2>
      <p class="form-desc">Demonstrates HTML form submission and Express body parsing in MVC architecture.</p>

      <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>

      <form action="/users" method="POST" class="user-form">
        <div class="form-group">
          <label for="name">Full Name *</label>
          <input type="text" id="name" name="name" placeholder="e.g. John Doe" required>
        </div>

        <div class="form-group">
          <label for="role">Role / Position *</label>
          <input type="text" id="role" name="role" placeholder="e.g. Back-End Developer" required>
        </div>

        <div class="form-group">
          <label for="email">Email Address *</label>
          <input type="email" id="email" name="email" placeholder="e.g. john@astanait.edu.kz" required>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Save User</button>
          <a href="/users" class="btn btn-secondary">Cancel</a>
        </div>
      </form>
    </div>
  </main>

  <footer class="footer">
    <div class="container">
      <p>&copy; 2026 Astana IT University - Web Technologies 2 (Back End)</p>
    </div>
  </footer>
</body>
</html>
